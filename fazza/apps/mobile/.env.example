# Public values only (they are embedded in the app). NEVER put the service role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Build-time only (used by app.config.ts, restrict the key to the app package/bundle id in Google Cloud)
GOOGLE_MAPS_ANDROID_API_KEY=
EAS_PROJECT_ID=
