    "@tanstack/react-query": "^5.108.4",
    "expo": "~58.0.26",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.1.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "doctor": "npx expo-doctor",
    "brand": "python3 ../brand/tools/extract_palette.py && node ../brand/tools/build_assets.mjs",
    "brand:assets": "node ../brand/tools/build_assets.mjs",
    "update": "eas update --auto",
    "build:dev": "eas build --profile development",
    "build:prod": "eas build --profile production --platform all",
    "e2e:web": "EXPO_PUBLIC_SUPABASE_URL=https://fikra-test.supabase.co EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_placeholder_for_bundle_check expo export --platform web --output-dir dist-web && node e2e/web-smoke.cjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
