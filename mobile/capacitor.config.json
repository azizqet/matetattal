{
  "appId": "com.mat3tl.app",
  "appName": "ماتعطل",
  "webDir": "www",
  "server": { "androidScheme": "https" },
  "android": { "allowMixedContent": false, "captureInput": true, "webContentsDebuggingEnabled": false },
  "ios": { "contentInset": "never", "scheme": "Matetattal", "limitsNavigationsToAppBoundDomains": false },
